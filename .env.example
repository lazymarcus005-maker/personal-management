DATABASE_URL=postgresql://user:***@ep-xxx.neon.tech/dbname?sslmode=require
AUTH_SECRET=generate-a-random-secret-here

# Public app URL used to build password reset links in email.
# Use your deployed URL in production, e.g. https://your-domain.com
AUTH_URL=http://localhost:3000

# Optional: required only if you want forgot-password email delivery to work.
# Without these, local/dev shows the reset link on screen, but production will
# report "sent" without delivering an email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Poj <no-reply@example.com>"

# Strava integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
